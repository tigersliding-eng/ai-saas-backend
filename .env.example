# DeepSeek API Key
# Get yours from: https://platform.deepseek.com/
DEEPSEEK_API_KEY=sk-your-api-key-here

# Alternatively, store an encrypted API key and a passphrase.
# Use `npm run encrypt:key` to generate the value from your real key.
# DEEPSEEK_API_KEY_ENC=<base64 encrypted key>
# DEEPSEEK_KEY_PASSPHRASE=your-passphrase

# Server port
PORT=3000
